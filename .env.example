# Copy to .env for running the app directly on the host (not in Docker).
# Docker Compose and Kubernetes each supply DATABASE_URL themselves — .env is
# only for `python app/main.py` / `uvicorn` started from your own shell.

# Local Postgres via docker compose, reached from the Windows host:
DATABASE_URL=postgresql+asyncpg://realtime:realtime@localhost:5432/realtime
DB_SSL=false
DB_ECHO=true

# AWS RDS — the only line that changes. Note db_ssl=true: RDS refuses plaintext.
# DATABASE_URL=postgresql+asyncpg://appuser:<password>@mydb.abc123.eu-west-1.rds.amazonaws.com:5432/realtime
# DB_SSL=true
# DB_ECHO=false
