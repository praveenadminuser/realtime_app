# Local development. Gitignored — never committed.
# Loaded into the api CONTAINER by docker-compose's `env_file:`, so every value
# here is read from the container's point of view.

# host.docker.internal = the Windows host, seen FROM INSIDE the container.
# NOT localhost: inside the container, localhost is the container itself.
# (If you point compose back at a `db:` service instead, this becomes `db`.)
# DB_HOST=host.docker.internal
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password1asdf
DB_NAME=realtimeapp

DB_SSL=false
DB_ECHO=true